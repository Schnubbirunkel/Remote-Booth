# Copy to .env and adjust:  cp .env.example .env

# Port on which the app is reachable in your network
APP_PORT=8090
# App data (settings, rooms, presets; default location of recordings, exports and media pool)
DATA_PATH=./data
# Storage you can choose in the folder browser (e.g. a large disk or a mounted network share)
STORAGE_PATH=./storage
# Folders the folder browser may show inside the container
BROWSE_ROOTS=/storage,/media
# Time zone
TZ=Etc/UTC

# Optional: fixed password for dashboard & editor (guests only need the invite link).
# If empty, the password is chosen in the setup screen on the first visit.
APP_PASSWORD=
# Optional: interface language for new visitors (de, en). Empty = browser language.
DEFAULT_LANGUAGE=
# Optional: owner of exported files (output of "id" in a terminal), otherwise writable for everyone
# PUID=1000
# PGID=1000

# How much CPU an export may use (percent of all threads). Lower = gentler on other services.
EXPORT_CPU=80
# Maximum number of people in a room
MAX_PEERS=4

# Extra services (comma-separated): tailscale, https, turn – empty = app only
COMPOSE_PROFILES=

# --- Profile "tailscale": auth key from login.tailscale.com → Settings → Keys ---
TS_AUTHKEY=
TS_HOSTNAME=remote-booth

# --- Profile "https": your domain pointing to your internet connection ---
# DOMAIN=podcast.example.com

# --- Only if calls do not connect: TURN ---
# Own coturn (profile "turn"): enter your public IP/domain
# TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_SECRET=a-long-random-secret
# PUBLIC_IP=203.0.113.10
# Or an external TURN service with fixed credentials:
# TURN_USER=
# TURN_PASS=
# Or a complete list as JSON (overrides everything else):
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
